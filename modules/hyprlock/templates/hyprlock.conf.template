# ==========================================================
# Xcalibur Hyprlock Theme
# Auto-generated. Do not edit.
# ==========================================================

# -----------------------------
# BACKGROUND
# -----------------------------

background {
    monitor =
    path = {{WALLPAPER}}

    blur_passes = 2
    blur_size = 6

    noise = 0.0117
    contrast = 1.2
    brightness = 0.8
    vibrancy = 0.2
    vibrancy_darkness = 0.2
}

# -----------------------------
# CLOCK
# -----------------------------

label {
    monitor =

    text = cmd[update:1000] echo "$(date +'%H:%M')"

    color = rgb({{FOREGROUND}})

    font_size = 72
    font_family = JetBrainsMono Nerd Font

    position = 0, 220

    halign = center
    valign = center
}

# -----------------------------
# DATE
# -----------------------------

label {
    monitor =

    text = cmd[update:60000] echo "$(date +'%A, %d %B %Y')"

    color = rgb({{MUTED}})

    font_size = 22
    font_family = JetBrainsMono Nerd Font

    position = 0, 160

    halign = center
    valign = center
}

# -----------------------------
# PASSWORD BOX
# -----------------------------

input-field {
    monitor =

    size = 320, 55

    position = 0, -120

    halign = center
    valign = center

    outline_thickness = 3

    dots_size = 0.25
    dots_spacing = 0.35

    dots_center = true

    outer_color = rgb({{BORDER}})
    inner_color = rgb({{SURFACE}})
    font_color = rgb({{FOREGROUND}})

    fade_on_empty = false

    placeholder_text = Password...
}
