#!/usr/bin/env bash

set -Eeuo pipefail

BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENGINE_DIR="$(dirname "$BIN_DIR")"

# ==========================================================
# Libraries
# ==========================================================

source "$ENGINE_DIR/lib/common.sh"
source "$ENGINE_DIR/lib/config.sh"
source "$ENGINE_DIR/lib/modules.sh"

load_config

readonly VERSION="0.1.0"

# ==========================================================
# Core Services
# ==========================================================

source "$ENGINE_DIR/services/wallpaper.sh"
source "$ENGINE_DIR/services/color_engine.sh"

# ==========================================================
# Renderer
# ==========================================================

source "$ENGINE_DIR/renderer/template.sh"

# ==========================================================
# Modules
# ==========================================================

load_modules

# ==========================================================
# Commands
# ==========================================================

source "$ENGINE_DIR/commands/help.sh"
source "$ENGINE_DIR/commands/version.sh"
source "$ENGINE_DIR/commands/status.sh"
source "$ENGINE_DIR/commands/doctor.sh"

source "$ENGINE_DIR/commands/render.sh"
source "$ENGINE_DIR/commands/wallpaper.sh"
source "$ENGINE_DIR/commands/palette.sh"

# ==========================================================
# Theme Pipeline
# ==========================================================

source "$ENGINE_DIR/services/apply.sh"

show_banner() {

    echo
    echo "========================================"
    echo "        Theme Engine v${VERSION}"
    echo "========================================"
    echo

}

main() {

    case "${1:-help}" in

        help|-h|--help)
            command_help
            ;;

        version|-v|--version)
            command_version
            ;;

        status)
            command_status
            ;;

        doctor)
            command_doctor
            ;;

        wallpaper)
            shift
            command_wallpaper "$@"
            ;;

        palette)
            shift
            command_palette "$@"
            ;;

        render)
            shift
            command_render "$@"
            ;;

        *)
            log_error "Unknown command: ${1:-}"
            echo
            command_help
            exit 1
            ;;

    esac

}

main "$@"
